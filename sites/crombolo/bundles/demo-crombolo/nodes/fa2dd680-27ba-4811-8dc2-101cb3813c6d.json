      "value": "Templates are typed components"
    },
    {
      "property": "codeIntro",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.TextArea",
      "value": "Write pages as React-style TSX components. They render to HTML on the server, with no React runtime and no hydration, and your changes show up without a restart."
    },
    {
      "property": "codeSample",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.TextArea",
      "value": "import type { PageProps } from '@crombolo/crombolo'\nimport { Layout } from '../shared/layout.tsx'\n\nexport default function Article({ model, nav }: PageProps) {\n  return (\n    <Layout model={model} nav={nav}>\n      <h1>{model.text('title')}</h1>\n      {model.html('bodyText')}\n    </Layout>\n  )\n}"
    },
    {
      "property": "eyebrow",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.TextBox",
      "value": "For developers"
    },
    {
      "property": "nextSteps",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.RichText",
      "value": {
        "markup": "<p>The README covers configuration, deployment, importing from Umbraco and the rest of the toolkit in depth.</p>",
        "blocks": null
      }
    },
    {
      "property": "standfirst",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.TextArea",
      "value": "Crombolo keeps the back office your editors know and rebuilds everything behind it in TypeScript on Bun. Here is what that means for you, and how to get started."
