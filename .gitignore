node_modules/
*.sqlite
*.sqlite-*
.env
.env.local
dist/
output/
# Scaffolded template sites: `bun run site <template>`, disposable.
.scaffolds/
# What a site in sites/ writes as it runs; its source and bundle are committed.
sites/*/media/
*.content-import.bak
# Sites staged as templates while packing; see scripts/sites.ts
packages/cli/templates/*
!packages/cli/templates/basic/
packages/backoffice-dist/dist/
packages/contracts/generated/
# Uploaded media belongs to the site's content, not the repository
apps/site/media/

# Site logs, written by the server and read by the log viewer
logs/

# Copied beside each manifest while packing; see scripts/publish-packages.ts
packages/*/LICENSE
packages/*/NOTICE
# View snapshots: cache, rebuilt from Views/ at boot, per node.
apps/site/.crombolo/

.crombolo/
