{
  "name": "@bunbraco/cli",
  "version": "0.4.0",
  "description": "The bunbraco command line: scaffolding a site, schema, views, domains, content transfer and upgrades.",
  "license": "MIT",
  "author": "Kineco",
  "homepage": "https://github.com/kineco-au/bunbraco-cms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/bunbraco-cms.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kineco-au/bunbraco-cms/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bin": "./bin/bunbraco.ts"
  },
  "bin": {
    "bunbraco": "./bin/bunbraco.ts"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bunbraco/auth": "workspace:*",
    "@bunbraco/core": "workspace:*",
    "@bunbraco/data": "workspace:*",
    "@bunbraco/schema": "workspace:*",
    "@bunbraco/server": "workspace:*",
    "@bunbraco/transfer": "workspace:*"
  }
}
