{
  "name": "@crombolo/cli",
  "version": "0.9.0",
  "description": "The crombolo command line: scaffolding a site, schema, views, domains, content transfer and upgrades.",
  "license": "MIT",
  "author": "Crombolo",
  "homepage": "https://github.com/kineco-au/crombolo-cms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/crombolo-cms.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kineco-au/crombolo-cms/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bin": "./bin/crombolo.ts"
  },
  "bin": {
    "crombolo": "./bin/crombolo.ts"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@crombolo/auth": "workspace:*",
    "@crombolo/core": "workspace:*",
    "@crombolo/data": "workspace:*",
    "@crombolo/schema": "workspace:*",
    "@crombolo/server": "workspace:*",
    "@crombolo/transfer": "workspace:*"
  }
}
