      "editor": "Umbraco.TextBox",
      "value": "A working shore, not a postcard."
    },
    {
      "property": "standfirst",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.TextArea",
      "value": "Harbourstone was raised in 1894 by the MacLeod shipping family, who wanted a malt that tasted of the coast their herring boats worked. The stillhouse has never moved from the shelf of rock above Stenwick cove."
    },
    {
      "property": "title",
      "culture": null,
      "segment": null,
      "editor": "Umbraco.TextBox",
      "value": "Built for weather, not for show."
