{
  "name": "bunbraco",
  "version": "0.3.0",
  "description": "An Umbraco-compatible CMS on Bun.",
  "license": "MIT",
  "author": "Kineco",
  "homepage": "https://github.com/kineco-au/bunbraco-cms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/bunbraco-cms.git",
    "directory": "packages/bunbraco"
  },
  "bugs": {
    "url": "https://github.com/kineco-au/bunbraco-cms/issues"
  },
  "keywords": [
    "cms",
    "umbraco",
    "bun",
    "content-management",
    "headless",
    "tsx",
    "sqlite",
    "postgres"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts"
  },
  "bin": {
    "bunbraco": "./bin/bunbraco.ts"
  },
  "files": [
    "src",
    "bin",
    "NOTICE"
  ],
  "dependencies": {
    "@bunbraco/api-management": "workspace:*",
    "@bunbraco/assistant": "workspace:*",
    "@bunbraco/auth": "workspace:*",
    "@bunbraco/backoffice-dist": "workspace:*",
    "@bunbraco/backoffice-host": "workspace:*",
    "@bunbraco/cli": "workspace:*",
    "@bunbraco/contracts": "workspace:*",
    "@bunbraco/core": "workspace:*",
    "@bunbraco/data": "workspace:*",
    "@bunbraco/render": "workspace:*",
    "@bunbraco/server": "workspace:*",
    "@bunbraco/schema": "workspace:*",
    "@bunbraco/transfer": "workspace:*"
  }
}
