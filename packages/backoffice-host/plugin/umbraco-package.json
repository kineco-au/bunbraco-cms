{
  "$schema": "../../backoffice-dist/dist/umbraco-package-schema.json",
  "name": "Bunbraco",
  "id": "Bunbraco.Core",
  "version": "0.5.1",
  "allowPublicAccess": false,
  "extensions": [
    {
      "type": "sectionView",
      "alias": "Bunbraco.SectionView.Bundles.Marketplace",
      "name": "Bunbraco Packages Marketplace",
      "element": "/bunbraco-plugin/bundles-marketplace.js",
      "weight": 300,
      "overwrites": ["Umb.SectionView.Packages.Marketplace"],
      "meta": {
        "label": "Marketplace",
        "pathname": "packages",
        "icon": "icon-cloud"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Packages"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Bunbraco.SectionView.Bundles.Created",
      "name": "Bunbraco Created Bundles",
      "element": "/bunbraco-plugin/bundles-created.js",
      "weight": 100,
      "overwrites": ["Umb.SectionView.Packages.Builder"],
      "meta": {
        "label": "Created",
        "pathname": "created",
        "icon": "icon-files"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Packages"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Bunbraco.SectionView.Bundles.Installed",
      "name": "Bunbraco Installed Packages",
      "element": "/bunbraco-plugin/bundles-installed.js",
      "weight": 200,
      "overwrites": ["Umb.SectionView.Packages.Installed"],
      "meta": {
        "label": "Installed",
        "pathname": "installed",
        "icon": "icon-box"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Packages"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Bunbraco.Dashboard.Changes",
      "name": "Bunbraco Changes Dashboard",
      "element": "/bunbraco-plugin/changes-dashboard.js",
      "weight": 5,
      "meta": {
        "label": "Changes",
        "pathname": "changes"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Bunbraco.Dashboard.Welcome",
      "name": "Bunbraco Welcome Dashboard",
      "element": "/bunbraco-plugin/welcome-dashboard.js",
      "weight": 20,
      "overwrites": ["Umb.Dashboard.UmbracoNews"],
      "meta": {
        "label": "Welcome",
        "pathname": "welcome"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Bunbraco.Dashboard.Settings",
      "name": "Bunbraco Settings Dashboard",
      "element": "/bunbraco-plugin/settings-dashboard.js",
      "weight": 500,
      "overwrites": ["Umb.Dashboard.SettingsWelcome"],
      "meta": {
        "label": "Welcome",
        "pathname": "welcome"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Bunbraco.EntryPoint.TsxEditors",
      "name": "Bunbraco TSX Template and Partial View Editors",
      "js": "/bunbraco-plugin/tsx-editors.js"
    },
    {
      "type": "headerApp",
      "alias": "Bunbraco.HeaderApp.ReadOnly",
      "name": "Bunbraco Read-only Banner",
      "element": "/bunbraco-plugin/read-only-banner.js",
      "weight": 1000
    },
    {
      "type": "workspaceFooterApp",
      "alias": "Bunbraco.WorkspaceFooterApp.ElementTypeHint",
      "name": "Bunbraco Element Type Library Hint",
      "element": "/bunbraco-plugin/element-type-hint.js",
      "weight": 900,
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.DocumentType"
        }
      ]
    },
    {
      "type": "localization",
      "alias": "Bunbraco.Localization.EN",
      "name": "Bunbraco English Overrides",
      "weight": 0,
      "meta": {
        "culture": "en"
      },
      "js": "/bunbraco-plugin/branding/localization-en.js"
    },
    {
      "type": "localization",
      "alias": "Bunbraco.Localization.EN_US",
      "name": "Bunbraco English (United States) Overrides",
      "weight": 0,
      "meta": {
        "culture": "en-us"
      },
      "js": "/bunbraco-plugin/branding/localization-en.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Bunbraco.EntryPoint.Branding",
      "name": "Bunbraco Branding",
      "js": "/bunbraco-plugin/branding/branding.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Bunbraco.EntryPoint.HelpMenu",
      "name": "Bunbraco Help Menu",
      "js": "/bunbraco-plugin/branding/help-menu.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Bunbraco.EntryPoint.Sysinfo",
      "name": "Bunbraco System Information Branding",
      "js": "/bunbraco-plugin/branding/sysinfo.js"
    },
    {
      "type": "section",
      "alias": "Bunbraco.Section.Forms",
      "name": "Bunbraco Forms Section",
      "weight": 50,
      "meta": {
        "label": "Forms",
        "pathname": "forms"
      }
    },
    {
      "type": "sectionView",
      "alias": "Bunbraco.SectionView.Forms.Overview",
      "name": "Bunbraco Forms Overview",
      "element": "/bunbraco-plugin/forms-overview.js",
      "weight": 200,
      "meta": {
        "label": "Forms",
        "pathname": "forms",
        "icon": "icon-notepad"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Bunbraco.Section.Forms"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Bunbraco.SectionView.Forms.Entries",
      "name": "Bunbraco Forms Entries",
      "element": "/bunbraco-plugin/forms-entries.js",
      "weight": 100,
      "meta": {
        "label": "Entries",
        "pathname": "entries",
        "icon": "icon-inbox"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Bunbraco.Section.Forms"
        }
      ]
    },
    {
      "type": "propertyEditorSchema",
      "name": "Form Picker",
      "alias": "Bunbraco.FormPicker",
      "meta": {
        "defaultPropertyEditorUiAlias": "Bunbraco.PropertyEditorUi.FormPicker"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "Bunbraco.PropertyEditorUi.FormPicker",
      "name": "Form Picker",
      "element": "/bunbraco-plugin/form-picker.js",
      "meta": {
        "label": "Form Picker",
        "icon": "icon-notepad",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Bunbraco.FormPicker"
      }
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Bunbraco.EntryPoint.ClientCredentials",
      "name": "Bunbraco Client Credential Prefix",
      "js": "/bunbraco-plugin/branding/client-credentials.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Bunbraco.EntryPoint.BundleBuilderLabels",
      "name": "Bunbraco Bundle Builder Labels",
      "js": "/bunbraco-plugin/branding/bundle-builder-labels.js"
    }
  ]
}
