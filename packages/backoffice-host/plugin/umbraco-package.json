{
  "$schema": "../../backoffice-dist/dist/umbraco-package-schema.json",
  "name": "Crombolo",
  "id": "Crombolo.Core",
  "version": "0.14.0",
  "allowPublicAccess": false,
  "extensions": [
    {
      "type": "mfaLoginProvider",
      "alias": "Crombolo.MfaLoginProvider.Authenticator",
      "name": "Crombolo Authenticator App",
      "forProviderName": "UmbracoUserAppAuthenticator",
      "element": "/crombolo-plugin/two-factor-setup.js",
      "meta": { "label": "Authenticator app" }
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Bundles.Marketplace",
      "name": "Crombolo Packages Marketplace",
      "element": "/crombolo-plugin/bundles-marketplace.js",
      "weight": 300,
      "overwrites": ["Umb.SectionView.Packages.Marketplace"],
      "meta": {
        "label": "Marketplace",
        "pathname": "packages",
        "icon": "icon-cloud"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Packages"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Bundles.Created",
      "name": "Crombolo Created Bundles",
      "element": "/crombolo-plugin/bundles-created.js",
      "weight": 100,
      "overwrites": ["Umb.SectionView.Packages.Builder"],
      "meta": {
        "label": "Created",
        "pathname": "created",
        "icon": "icon-files"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Packages"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Bundles.Installed",
      "name": "Crombolo Installed Packages",
      "element": "/crombolo-plugin/bundles-installed.js",
      "weight": 200,
      "overwrites": ["Umb.SectionView.Packages.Installed"],
      "meta": {
        "label": "Installed",
        "pathname": "installed",
        "icon": "icon-box"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Packages"
        }
      ]
    },
    {
      "type": "workspaceView",
      "alias": "Crombolo.WorkspaceView.Webhook.Storage",
      "name": "Crombolo Webhook Storage View",
      "element": "/crombolo-plugin/webhook-storage.js",
      "weight": 100,
      "meta": {
        "label": "Where it's kept",
        "pathname": "where-kept",
        "icon": "icon-box"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Webhook"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Crombolo.Dashboard.Addresses",
      "name": "Crombolo Page Addresses Dashboard",
      "element": "/crombolo-plugin/addresses-dashboard.js",
      "weight": 6,
      "meta": {
        "label": "Page addresses",
        "pathname": "addresses"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Crombolo.Dashboard.Changes",
      "name": "Crombolo Changes Dashboard",
      "element": "/crombolo-plugin/changes-dashboard.js",
      "weight": 5,
      "meta": {
        "label": "Changes",
        "pathname": "changes"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Crombolo.Dashboard.AuditLog",
      "name": "Crombolo Audit Log Dashboard",
      "element": "/crombolo-plugin/audit-dashboard.js",
      "weight": 4,
      "meta": {
        "label": "Audit log",
        "pathname": "audit-log"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Crombolo.Dashboard.Welcome",
      "name": "Crombolo Welcome Dashboard",
      "element": "/crombolo-plugin/welcome-dashboard.js",
      "weight": 20,
      "overwrites": ["Umb.Dashboard.UmbracoNews"],
      "meta": {
        "label": "Welcome",
        "pathname": "welcome"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Crombolo.Dashboard.Settings",
      "name": "Crombolo Settings Dashboard",
      "element": "/crombolo-plugin/settings-dashboard.js",
      "weight": 500,
      "overwrites": ["Umb.Dashboard.SettingsWelcome"],
      "meta": {
        "label": "Welcome",
        "pathname": "welcome"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.TsxEditors",
      "name": "Crombolo TSX Template and Partial View Editors",
      "js": "/crombolo-plugin/tsx-editors.js"
    },
    {
      "type": "headerApp",
      "alias": "Crombolo.HeaderApp.ReadOnly",
      "name": "Crombolo Read-only Banner",
      "element": "/crombolo-plugin/read-only-banner.js",
      "weight": 1000
    },
    {
      "type": "headerApp",
      "kind": "button",
      "alias": "Crombolo.HeaderApp.Settings",
      "name": "Crombolo Settings Header App",
      "weight": 300,
      "meta": {
        "label": "Settings",
        "icon": "icon-settings",
        "href": "section/settings"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionUserPermission",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "workspaceFooterApp",
      "alias": "Crombolo.WorkspaceFooterApp.ElementTypeHint",
      "name": "Crombolo Element Type Library Hint",
      "element": "/crombolo-plugin/element-type-hint.js",
      "weight": 900,
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.DocumentType"
        }
      ]
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.Branding",
      "name": "Crombolo Branding",
      "js": "/crombolo-plugin/branding/branding.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.HelpMenu",
      "name": "Crombolo Help Menu",
      "js": "/crombolo-plugin/branding/help-menu.js"
    },
    {
      "type": "section",
      "alias": "Crombolo.Section.Forms",
      "name": "Crombolo Forms Section",
      "weight": 50,
      "meta": {
        "label": "Forms",
        "pathname": "forms"
      }
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Forms.Overview",
      "name": "Crombolo Forms Overview",
      "element": "/crombolo-plugin/forms-overview.js",
      "weight": 100,
      "meta": {
        "label": "Forms",
        "pathname": "forms",
        "icon": "icon-notepad"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Crombolo.Section.Forms"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Forms.Entries",
      "name": "Crombolo Forms Entries",
      "element": "/crombolo-plugin/forms-entries.js",
      "weight": 200,
      "meta": {
        "label": "Entries",
        "pathname": "entries",
        "icon": "icon-inbox"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Crombolo.Section.Forms"
        }
      ]
    },
    {
      "type": "propertyEditorSchema",
      "name": "Form Picker",
      "alias": "Crombolo.FormPicker",
      "meta": {
        "defaultPropertyEditorUiAlias": "Crombolo.PropertyEditorUi.FormPicker"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "Crombolo.PropertyEditorUi.FormPicker",
      "name": "Form Picker",
      "element": "/crombolo-plugin/form-picker.js",
      "meta": {
        "label": "Form Picker",
        "icon": "icon-notepad",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Crombolo.FormPicker"
      }
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.ClientCredentials",
      "name": "Crombolo Client Credential Prefix",
      "js": "/crombolo-plugin/branding/client-credentials.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.BundleBuilderLabels",
      "name": "Crombolo Bundle Builder Labels",
      "js": "/crombolo-plugin/branding/bundle-builder-labels.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.ComponentsTree",
      "name": "Crombolo Components Tree",
      "js": "/crombolo-plugin/branding/components-tree.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.ContentTypeLabels",
      "name": "Crombolo Content Type Labels",
      "js": "/crombolo-plugin/branding/content-type-labels.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.QueryBuilder",
      "name": "Crombolo Query Builder Language",
      "js": "/crombolo-plugin/branding/query-builder.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.SignIn",
      "name": "Crombolo Sign-in Button",
      "js": "/crombolo-plugin/branding/sign-in.js"
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "Crombolo.EntryPoint.LogViewerMenu",
      "name": "Crombolo Log Viewer Search Menu",
      "js": "/crombolo-plugin/branding/log-viewer-menu.js"
    },
    {
      "type": "globalContext",
      "alias": "Crombolo.GlobalContext.Icons",
      "name": "Crombolo Icons Context",
      "overwrites": ["Umb.GlobalContext.Icons"],
      "api": "/crombolo-plugin/branding/icon-registry.js"
    },
    {
      "type": "section",
      "alias": "Crombolo.Section.Workflow",
      "name": "Crombolo Workflow Section",
      "weight": 40,
      "meta": {
        "label": "Workflows",
        "pathname": "workflow"
      }
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Workflow.Waiting",
      "name": "Crombolo Workflow Waiting",
      "element": "/crombolo-plugin/workflow-requests.js",
      "elementName": "crombolo-workflow-waiting",
      "weight": 400,
      "meta": {
        "label": "Waiting for me",
        "pathname": "waiting",
        "icon": "icon-inbox"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Crombolo.Section.Workflow"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Workflow.InFlight",
      "name": "Crombolo Workflow In Flight",
      "element": "/crombolo-plugin/workflow-requests.js",
      "elementName": "crombolo-workflow-in-flight",
      "weight": 300,
      "meta": {
        "label": "In flight",
        "pathname": "in-flight",
        "icon": "icon-time"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Crombolo.Section.Workflow"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Workflow.History",
      "name": "Crombolo Workflow History",
      "element": "/crombolo-plugin/workflow-requests.js",
      "elementName": "crombolo-workflow-history",
      "weight": 200,
      "meta": {
        "label": "Decided",
        "pathname": "history",
        "icon": "icon-check"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Crombolo.Section.Workflow"
        }
      ]
    },
    {
      "type": "sectionView",
      "alias": "Crombolo.SectionView.Workflow.Designer",
      "name": "Crombolo Workflow Designer",
      "element": "/crombolo-plugin/workflow-designer.js",
      "weight": 100,
      "meta": {
        "label": "Workflows",
        "pathname": "workflows",
        "icon": "icon-mindmap"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Crombolo.Section.Workflow"
        },
        {
          "alias": "Umb.Condition.CurrentUser.IsAdmin"
        }
      ]
    },
    {
      "type": "workspaceView",
      "alias": "Crombolo.WorkspaceView.Document.Workflow",
      "name": "Crombolo Document Workflow",
      "element": "/crombolo-plugin/workflow-tab.js",
      "weight": 50,
      "meta": {
        "label": "Workflow",
        "pathname": "workflow",
        "icon": "icon-mindmap"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Document"
        }
      ]
    }
  ]
}
